[Unit]
Description=Whispering Willow
After=network.target sound.target

[Service]
User=whisperer
Group=whisperer
WorkingDirectory=/home/whisperer/src/whispering-willow
ExecStart=/usr/bin/python3 /home/whisperer/src/whispering-willow/main.py
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
